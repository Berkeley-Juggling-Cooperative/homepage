{#
  Video is served from R2, not from the site itself: Cloudflare Pages caps a
  single file at 25 MiB and roundabout.mp4 is 79 MiB.  Callers pass a
  site-relative src such as "/videos/roundabout.mp4" and the media host is
  prepended here.

  Served from the bucket's custom domain, which is cached at the edge.  This
  replaced the r2.dev development hostname on 2026-08-18, when the domain moved
  to Cloudflare; the CSP in files/_headers was narrowed to match.
#}
<div>
  <video
    src="https://media.berkeleyjuggling.org{{ src }}"
    controls
    preload="metadata"
    playsinline
    {% if width %}
        width="{{ width }}"
    {% endif %}
    {% if height %}
        height="{{ height }}"
    {% endif %}
    {% if poster %}
        poster="{{ poster }}"
    {% endif %}
    {% if autoplay %}
        autoplay
    {% endif %}
    {% if muted %}
        muted
    {% endif %}
    {% if loop %}
        loop
    {% endif %}
  >
    Your browser does not support the video tag.
  </video>
</div>
