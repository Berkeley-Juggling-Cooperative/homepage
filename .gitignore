.envrc


# we don't want to commit large images and videos to git
# (they live on the server in *_orig/, use 'nikola deploy download')
#
# The galleries/**/index.txt files are the exception: they are hand-written
# source, not media.  Each one holds a gallery's previewimage and its
# '.. videos:' opt-in, and galleries/index.txt carries the intro prose, so
# they encode editorial decisions that belong in history.  All 12 together are
# under 1 KB.  Without this they existed only in R2, where 'rclone copy' never
# deletes -- so a renamed gallery left its old index.txt there forever with no
# way to tell which was current, and no diff or blame for any of it.
#
# Git will not descend into an excluded *directory*, so a bare 'galleries'
# plus a negation silently matches nothing.  Exclude the contents instead,
# re-include the directories so git walks them, then re-exclude the media a
# level down before re-including index.txt.  Drop the 'galleries/*/*' line and
# every photo comes back with it.
galleries/*
!galleries/*/
galleries/*/*
!galleries/**/index.txt
images
videos
# festival media lives in R2 (bjc-r2:bjc-media/festivals), never in git.
# Restored to these paths at build time, so the archived HTML is never rewritten.
files/festivals/**/*.png
files/festivals/**/*.jpg
files/festivals/**/*.jpeg
files/festivals/**/*.gif
files/festivals/**/*.pdf
# ...except the 2008 flyer, which the page links to and is only 0.26 MB.
# Nothing syncs files/ to R2, so anything excluded here has no backup.
!files/festivals/2008/bjuf_flyer.pdf
files/festivals/**/*.webm
files/festivals/**/*.mp4
